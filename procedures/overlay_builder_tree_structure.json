	"tooltip": "Renders an in-world 3D hologram of a captured tree structure (.nbt, imported via MCreator's Structures panel) scaled to growth percentage (0 to 1). The structure input accepts the structure picker block, a plain text block, or any String-producing variable/expression, so the structure name can be computed/changed programmatically. Uniform scale grows the whole structure evenly; bottom-up reveal shows more of the structure from the ground up as it grows. Supports shape bounds and Y-offset (pixels).",
	"mcreator": {
		"toolbox_id": "blockoverlays",
		"toolbox_init": [
			"<value name=\"structure\"><block type=\"structure_selector\"><field name=\"structure\"></field></block></value>",
			"<value name=\"percentage\"><block type=\"math_number\"><field name=\"NUM\">0.5</field></block></value>",
			"<value name=\"offset_y\"><block type=\"math_number\"><field name=\"NUM\">0</field></block></value>",
			"<value name=\"scale\"><block type=\"math_number\"><field name=\"NUM\">1</field></block></value>",
			"<value name=\"bounds\"><block type=\"logic_boolean\"><field name=\"BOOL\">FALSE</field></block></value>"
		],
